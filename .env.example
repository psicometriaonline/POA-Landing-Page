# Integração com o Active Campaign (pop-up de captura → CRM).
# No Replit, cadastre estes valores em Tools › Secrets — nunca neste arquivo.

# URL da conta, sem barra no final. Está em Settings › Developer no Active Campaign.
ACTIVECAMPAIGN_API_URL=https://SUACONTA.api-us1.com

# Chave de API, também em Settings › Developer.
ACTIVECAMPAIGN_API_KEY=

# Lista "Leads" onde os contatos são inscritos.
ACTIVECAMPAIGN_LIST_ID=31

# Banco de dados (opcional): guarda uma cópia local de cada lead.
DATABASE_URL=
